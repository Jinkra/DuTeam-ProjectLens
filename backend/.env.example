PORT=4100
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated production origins. Localhost ports are allowed in development.
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
# Comma-separated emails that can open /admin. Never place passwords here.
ADMIN_EMAILS=admin@example.com
ADMIN_USERNAME=admin
# Demo default is admin123. Replace it before deploying to production.
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@projectlens.local

# Optional public judge account. Leave both fields empty to disable it.
JUDGE_NAME=评委测试账号
JUDGE_EMAIL=
JUDGE_PASSWORD=
JUDGE_PLAN=pro

# AI providers are configured in /admin and stored in backend/data/database.db.
